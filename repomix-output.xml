              placeholderTextColor="#A0A0A0"
              maxLength={10}
            />

            <Text style={styles.label}>Telefone</Text>
            <TextInput
              style={styles.input}
              value={telefone}
              onChangeText={handleTelefoneChange} 
              keyboardType="phone-pad"
