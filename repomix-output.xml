    // Apaga o código usado por segurança
    await docRef.delete();

    console.log(`[SUCESSO] Token de LOGIN gerado para ${email}`);

    // Devolve o token para o aplicativo
    return res.status(200).json({ token: customToken });

  } catch (error) {
